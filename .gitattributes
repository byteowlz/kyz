# Normalize all text files to LF in the repository and on checkout, so
# generated-file comparisons (examples/config.toml, examples/config.schema.json)
# behave identically on every platform including Windows runners with
# core.autocrlf=true.
* text=auto eol=lf
.trx/issues.jsonl text eol=lf merge=union
.trx/events.jsonl text eol=lf merge=union
.trx/verifications.jsonl text eol=lf merge=union
