{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byteowlz.com/schemas/credential-access/v1/credential-access.schema.json",
  "title": "Credential access contract v1",
  "description": "Messages between a credential consumer and a credential broker. One JSON object per line over a local, authenticated transport. The caller is identified by the transport, never by fields in the message. See README.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "id": {
      "description": "Request id chosen by the consumer; echoed in the response.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "secret_ref": {
      "description": "Backend-qualified secret reference: <scheme>:<body>. Schemes defined in README.md (env, kyz, op, bw). Parsed by the shared resolver, never by consumers.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9+.-]*:\\S+$",
      "maxLength": 1024
    },
    "audience": {
      "description": "Registered token kind, e.g. owa-mail-calendar, teams-chat, graph. Never a raw URL.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 128
    },
    "origin": {
      "description": "Web origin: scheme, host and optional port; no path, query or fragment.",
      "type": "string",
      "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?$|^http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]{1,5})?$"
    },
    "b64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]*$"
    },
    "purpose": {
      "description": "Short human-readable reason, shown in the approval prompt. Untrusted text.",
      "type": "string",
      "maxLength": 280
    },
    "request": {
      "type": "object",
      "required": [
        "v",
        "id",
        "op"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "enum": [
            "resolve",
            "token",
            "use"
          ]
        },
        "purpose": {
          "$ref": "#/$defs/purpose"
        },
        "resolve": {
          "$ref": "#/$defs/resolve_params"
        },
        "token": {
          "$ref": "#/$defs/token_params"
        },
        "use": {
          "$ref": "#/$defs/use_params"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "resolve"
              }
            }
          },
          "then": {
            "required": [
              "resolve"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "token"
                  ]
                },
                {
                  "required": [
                    "use"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "token"
              }
            }
          },
          "then": {
            "required": [
              "token"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "resolve"
                  ]
                },
                {
                  "required": [
                    "use"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "use"
              }
            }
          },
          "then": {
            "required": [
              "use"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "resolve"
                  ]
                },
                {
                  "required": [
                    "token"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "resolve_params": {
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/secret_ref"
        }
      },
      "additionalProperties": false
    },
    "token_params": {
      "type": "object",
      "required": [
        "audience"
      ],
      "properties": {
        "audience": {
          "$ref": "#/$defs/audience"
        },
        "scopes": {
          "description": "Scopes the consumer needs. The broker refuses rather than returning a token lacking them.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "min_ttl_s": {
          "description": "Minimum remaining lifetime the consumer needs, in seconds.",
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      },
      "additionalProperties": false
    },
    "use_params": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "fill",
            "webauthn_get",
            "http"
          ]
        },
        "fill": {
          "$ref": "#/$defs/use_fill"
        },
        "webauthn_get": {
          "$ref": "#/$defs/use_webauthn_get"
        },
        "http": {
          "$ref": "#/$defs/use_http"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fill"
              }
            }
          },
          "then": {
            "required": [
              "fill"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "webauthn_get"
                  ]
                },
                {
                  "required": [
                    "http"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "webauthn_get"
              }
            }
          },
          "then": {
            "required": [
              "webauthn_get"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "fill"
                  ]
                },
                {
                  "required": [
                    "http"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "http"
              }
            }
          },
          "then": {
            "required": [
              "http"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "fill"
                  ]
                },
                {
                  "required": [
                    "webauthn_get"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "use_fill": {
      "description": "Fill login fields in the page at origin, inside the browser that owns the page. Values never travel back to the consumer.",
      "type": "object",
      "required": [
        "origin",
        "ref",
        "fields"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "ref": {
          "$ref": "#/$defs/secret_ref"
        },
        "fields": {
          "type": "array",
          "items": {
            "enum": [
              "username",
              "password",
              "totp"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "browser_session": {
          "description": "Opaque id of the browser tab/session to fill, issued by the browser integration.",
          "type": "string",
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "use_webauthn_get": {
      "description": "Produce a WebAuthn assertion. Requires one live human approval per ceremony; the authenticator sets UP/UV only when that gesture happened.",
      "type": "object",
      "required": [
        "origin",
        "rp_id",
        "client_data_hash"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "rp_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]+$",
          "maxLength": 253
        },
        "client_data_hash": {
          "$ref": "#/$defs/b64url",
          "minLength": 43,
          "maxLength": 43
        },
        "allow_credentials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/b64url"
          },
          "maxItems": 64
        },
        "user_verification": {
          "enum": [
            "required",
            "preferred",
            "discouraged"
          ]
        }
      },
      "additionalProperties": false
    },
    "use_http": {
      "description": "The broker performs one HTTP request with the credential injected and returns the response. The credential never reaches the consumer.",
      "type": "object",
      "required": [
        "credential",
        "request"
      ],
      "properties": {
        "credential": {
          "type": "object",
          "oneOf": [
            {
              "required": [
                "audience"
              ],
              "properties": {
                "audience": {
                  "$ref": "#/$defs/audience"
                }
              },
              "additionalProperties": false
            },
            {
              "required": [
                "ref"
              ],
              "properties": {
                "ref": {
                  "$ref": "#/$defs/secret_ref"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "request": {
          "type": "object",
          "required": [
            "method",
            "url"
          ],
          "properties": {
            "method": {
              "enum": [
                "GET",
                "HEAD",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
              ]
            },
            "url": {
              "type": "string",
              "pattern": "^https://\\S+$",
              "maxLength": 8192
            },
            "headers": {
              "description": "Consumer headers. Credential-bearing headers are forbidden; the broker injects them.",
              "type": "object",
              "propertyNames": {
                "not": {
                  "pattern": "^([Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Cc][Oo][Oo][Kk][Ii][Ee]|[Pp][Rr][Oo][Xx][Yy]-[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn])$"
                }
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "body_b64": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": [
        "v",
        "id",
        "status"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "ok",
            "needs_interaction",
            "denied",
            "unavailable"
          ]
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/resolve_result"
            },
            {
              "$ref": "#/$defs/token_result"
            },
            {
              "$ref": "#/$defs/fill_result"
            },
            {
              "$ref": "#/$defs/webauthn_result"
            },
            {
              "$ref": "#/$defs/http_result"
            }
          ]
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "receipt_id": {
          "description": "Id of the value-free decision receipt recorded for this request.",
          "type": "string",
          "maxLength": 128
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "required": [
              "result"
            ],
            "not": {
              "required": [
                "error"
              ]
            }
          },
          "else": {
            "required": [
              "error"
            ],
            "not": {
              "required": [
                "result"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "needs_interaction"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "properties": {
                  "reason": {
                    "enum": [
                      "login_required",
                      "unlock_required",
                      "approval_required"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "denied"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "properties": {
                  "reason": {
                    "enum": [
                      "not_granted",
                      "approval_rejected",
                      "approval_timeout",
                      "policy"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "properties": {
                  "reason": {
                    "enum": [
                      "not_found",
                      "audience_unavailable",
                      "scope_unavailable",
                      "cannot_refresh",
                      "backend_offline",
                      "unsupported",
                      "invalid_request"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "resolve_result": {
      "type": "object",
      "required": [
        "kind",
        "secret"
      ],
      "properties": {
        "kind": {
          "const": "resolve"
        },
        "secret": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "token_result": {
      "type": "object",
      "required": [
        "kind",
        "token",
        "token_type",
        "audience",
        "scopes",
        "expires_at",
        "can_refresh"
      ],
      "properties": {
        "kind": {
          "const": "token"
        },
        "token": {
          "type": "string",
          "minLength": 1
        },
        "token_type": {
          "enum": [
            "bearer"
          ]
        },
        "audience": {
          "$ref": "#/$defs/audience"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "expires_at": {
          "description": "Unix seconds.",
          "type": "integer",
          "minimum": 1
        },
        "can_refresh": {
          "description": "Whether this broker can renew the token on this host without human interaction.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "fill_result": {
      "type": "object",
      "required": [
        "kind",
        "filled"
      ],
      "properties": {
        "kind": {
          "const": "fill"
        },
        "filled": {
          "type": "array",
          "items": {
            "enum": [
              "username",
              "password",
              "totp"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "webauthn_result": {
      "type": "object",
      "required": [
        "kind",
        "credential_id",
        "authenticator_data",
        "signature"
      ],
      "properties": {
        "kind": {
          "const": "webauthn_get"
        },
        "credential_id": {
          "$ref": "#/$defs/b64url"
        },
        "authenticator_data": {
          "$ref": "#/$defs/b64url"
        },
        "signature": {
          "$ref": "#/$defs/b64url"
        },
        "user_handle": {
          "$ref": "#/$defs/b64url"
        }
      },
      "additionalProperties": false
    },
    "http_result": {
      "type": "object",
      "required": [
        "kind",
        "status"
      ],
      "properties": {
        "kind": {
          "const": "http"
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "headers": {
          "description": "Response headers with credential-bearing headers (Set-Cookie, Authorization, WWW-Authenticate challenges carrying tokens) removed by the broker.",
          "type": "object",
          "propertyNames": {
            "not": {
              "pattern": "^([Ss][Ee][Tt]-[Cc][Oo][Oo][Kk][Ii][Ee]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn])$"
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "body_b64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "enum": [
            "login_required",
            "unlock_required",
            "approval_required",
            "not_granted",
            "approval_rejected",
            "approval_timeout",
            "policy",
            "not_found",
            "audience_unavailable",
            "scope_unavailable",
            "cannot_refresh",
            "backend_offline",
            "unsupported",
            "invalid_request"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        },
        "interaction": {
          "description": "Where the human must act. Present only with needs_interaction.",
          "type": "object",
          "properties": {
            "hint": {
              "type": "string",
              "maxLength": 280
            },
            "host": {
              "description": "Host on which the interaction must happen.",
              "type": "string",
              "maxLength": 253
            }
          },
          "additionalProperties": false
        },
        "retry_after_s": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
